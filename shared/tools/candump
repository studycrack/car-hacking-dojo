#!/run/dojo/bin/python3 -u
import argparse
import os
import sys
import time

sys.path.insert(0, "/challenge")
import vcan


def parse_filter(text):
    inverted = text.startswith("~")
    can_id, _, mask = (text[1:] if inverted else text).partition(":")
    return int(can_id, 16), int(mask, 16) if mask else 0x7FF, inverted


def main():
    parser = argparse.ArgumentParser(
        description="dump CAN traffic",
        usage="candump [-a] [-t] [-n COUNT] INTERFACE[,ID:MASK][,~ID:MASK]...",
    )
    parser.add_argument("-a", "--ascii", action="store_true", help="show the payload as ascii")
    parser.add_argument("-t", "--timestamp", action="store_true", help="show a timestamp for each frame")
    parser.add_argument("-n", "--count", type=int, help="exit after COUNT frames")
    parser.add_argument("interfaces", nargs="+", metavar="INTERFACE[,ID:MASK]")
    args = parser.parse_args()

    if len(args.interfaces) > 1:
        parser.error("this candump only supports a single interface")

    interface, _, filter_spec = args.interfaces[0].partition(",")
    filters = [parse_filter(part) for part in filter_spec.split(",") if part]

    bus = vcan.attach(interface, "candump")

    start = time.time()
    dumped = 0
    for can_id, data in bus.frames():
        if filters and not any((can_id & mask == wanted & mask) != inverted
                               for wanted, mask, inverted in filters):
            continue
        line = ""
        if args.timestamp:
            line += f"({time.time() - start:012.6f}) "
        line += f" {interface}  {can_id:03X}   [{len(data)}]  " + " ".join(f"{byte:02X}" for byte in data)
        if args.ascii:
            line += "   '" + vcan.ascii_repr(data) + "'"
        print(line)
        dumped += 1
        if args.count and dumped >= args.count:
            break


if __name__ == "__main__":
    try:
        main()
    except (KeyboardInterrupt, BrokenPipeError):
        os._exit(0)
