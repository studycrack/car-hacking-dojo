#!/run/dojo/bin/python3 -u
import sys

sys.path.insert(0, "/challenge")
import ble


def main():
    arguments = sys.argv[1:]
    if not arguments or arguments[0] != "lescan":
        sys.exit("usage: hcitool lescan [--passive]\n"
                 "   a passive scan sends no scan request, so it never sees a scan response")

    active = "--passive" not in arguments
    devices = ble.scan(active=active)
    if not devices:
        sys.exit("hcitool: no peripherals are advertising (is the challenge running?)")

    print("LE Scan ...")
    for address, advertisement, response in devices:
        structures = ble.Advertisement.parse(advertisement)
        if response:
            structures += ble.Advertisement.parse(response)
        print(f"{address} {ble.local_name(structures) or '(unknown)'}")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
