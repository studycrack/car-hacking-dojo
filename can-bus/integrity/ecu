#!/run/dojo/bin/python3 -u
import random
import sys
import threading
import time

sys.path.insert(0, "/challenge")
import vcan

COMMAND_ID = 0x1F5
STATUS_ID = 0x1F6
BUTTON_ID = 0x0FE
FLAG_ID = 0x7C0

TARGET_TORQUE = 0x0BB8
DEMO_TORQUE = 0x00C8
REQUIRED_STREAK = 8
CHECKSUM_OFFSET = 0x5A

RESULT_IDLE = 0x00
RESULT_ACCEPTED = 0x01
RESULT_BAD_CHECKSUM = 0x10
RESULT_BAD_COUNTER = 0x11

bus = vcan.Bus("vcan0")
demo = vcan.Bus("vcan0")
flag = open("/flag").read().strip()

last_result = RESULT_IDLE
streak = 0
last_counter = None
state = threading.Lock()


def checksum(payload):
    return (sum(payload) + CHECKSUM_OFFSET) & 0xFF


def status():
    with state:
        return bytes([last_result, streak, 0x00, 0x00])


def park_assist_burst():
    counter = random.randrange(16)
    for _ in range(10):
        payload = bytes([DEMO_TORQUE >> 8, DEMO_TORQUE & 0xFF, 0x00, 0x00, 0x00, 0x00, counter])
        demo.send(COMMAND_ID, payload + bytes([checksum(payload)]))
        counter = (counter + 1) % 16
        time.sleep(0.1)


vcan.transmit_periodically(bus, 0x0C0, lambda: bytes([0x03, 0x20, 0, 0, 0x27, 0x10, 0, 0]), hz=10)
vcan.transmit_periodically(bus, 0x1A0, lambda: bytes([0, 0, 0, 0, 0, 0, 0, 0]), hz=5)
vcan.transmit_periodically(bus, 0x3C1, lambda: bytes([0x5A, 0x00, 0x44, 0x00]), hz=2)
vcan.transmit_periodically(bus, STATUS_ID, status, hz=4)

for can_id, data in bus.frames():
    if can_id == BUTTON_ID:
        threading.Thread(target=park_assist_burst, daemon=True).start()
        continue

    if can_id != COMMAND_ID or len(data) != 8:
        continue

    if data[7] != checksum(data[:7]) or data[6] >> 4:
        with state:
            last_result = RESULT_BAD_CHECKSUM if data[7] != checksum(data[:7]) else RESULT_BAD_COUNTER
            streak = 0
            last_counter = None
        continue

    counter = data[6] & 0x0F
    with state:
        expected = None if last_counter is None else (last_counter + 1) % 16
        if expected is not None and counter != expected:
            last_result = RESULT_BAD_COUNTER
            last_counter = counter
            streak = 0
            continue
        last_counter = counter
        last_result = RESULT_ACCEPTED
        streak = streak + 1 if (data[0] << 8 | data[1]) == TARGET_TORQUE else 0
        won = streak >= REQUIRED_STREAK
        if won:
            streak = 0

    if won:
        bus.send_text(FLAG_ID, flag)
