#!/run/dojo/bin/python3 -u
"""A rolling code receiver that resynchronises, and can be walked backwards.

Kevin2600 and Wesley Li reported this in 2022 as Rolling-PWN
(CVE-2021-46145), against Honda vehicles built from 2012 onward. A rolling
code receiver has to tolerate a fob pressed out of range, so it keeps a window
and, when it sees a run of consecutive counters, it takes that run as proof it
has fallen behind the fob and resynchronises to it.

The assumption underneath is that only the real fob can produce consecutive
valid codes. A recording can: it holds a run of them. So a captured sequence
replayed later drags the counter back to where it was recorded, and the codes
that follow it in the recording become live again.

This receiver is the one in `rolling-code` with that tolerance added, so the
single unconsumed code that worked there is not enough here: the counter has
moved far past it before you get a chance.
"""
import random
import sys
import threading
import time

sys.path.insert(0, "/challenge")
import vcan

FOB_ID = 0x2C5
STATUS_ID = 0x19A
BUTTON_ID = 0x0FF
FLAG_ID = 0x7C0

REPEATS = 4
DEBOUNCE_SECONDS = 1.0
WINDOW = 256
SECRET = 0x5C71E93A
COUNTER_MASK = 0xFFFF

# a run this long is taken as the fob having got ahead while out of range, and
# the receiver resynchronises to it. Nothing checks whether the run is ahead of
# where the receiver already is, which is the whole flaw.
RESYNC_RUN = 3

RESULT_IDLE = 0x00
RESULT_UNLOCKED = 0x01
RESULT_STALE_COUNTER = 0x02
RESULT_BAD_CODE = 0x03
RESULT_RESYNCED = 0x04

bus = vcan.Bus("vcan0")
fob = vcan.Bus("vcan0")
flag = open("/flag").read().strip()

fob_counter = random.randrange(0x1000, 0x2000)
accepted_counter = (fob_counter - 1) & COUNTER_MASK
high_water = accepted_counter
deaf_until = 0.0
unlocks = 0
last_result = RESULT_IDLE
run = []
state = threading.Lock()


def code_for(counter):
    mixed = (counter * 0x9E3779B1 ^ SECRET) & 0xFFFFFFFF
    return ((mixed >> 11) ^ mixed) & 0xFFFFFFFF


def transmission(counter):
    code = code_for(counter)
    return bytes([counter >> 8 & 0xFF, counter & 0xFF,
                  code >> 24 & 0xFF, code >> 16 & 0xFF, code >> 8 & 0xFF, code & 0xFF])


def status():
    with state:
        return bytes([0x01 if unlocks == 0 else 0x00, unlocks & 0xFF, last_result,
                      accepted_counter >> 8 & 0xFF, accepted_counter & 0xFF, 0x00])


def press_button():
    global fob_counter
    for _ in range(REPEATS):
        fob.send(FOB_ID, transmission(fob_counter))
        fob_counter = (fob_counter + 1) & COUNTER_MASK
        time.sleep(0.05)


vcan.transmit_periodically(bus, 0x0C0,
                           lambda: bytes([0x03, 0x20, 0, 0, 0x27, 0x10, 0, 0]), hz=10)
vcan.transmit_periodically(bus, 0x3C1, lambda: bytes([0x5A, 0x00, 0x44, 0x00]), hz=2)
vcan.transmit_periodically(bus, STATUS_ID, status, hz=4)

for can_id, data in bus.frames():
    if can_id == BUTTON_ID:
        press_button()
        continue
    if can_id != FOB_ID or len(data) != 6:
        continue
    if time.time() < deaf_until:
        continue

    counter = data[0] << 8 | data[1]
    code = int.from_bytes(data[2:6], "big")

    with state:
        if code != code_for(counter):
            last_result = RESULT_BAD_CODE
            run = []
            continue

        # a valid code that is not ahead still counts toward a run, because the
        # receiver is trying to work out whether it is the one that fell behind
        ahead = 0 < (counter - accepted_counter) & COUNTER_MASK <= WINDOW
        if run and counter == (run[-1] + 1) & COUNTER_MASK:
            run.append(counter)
        else:
            run = [counter]

        if not ahead:
            if len(run) >= RESYNC_RUN:
                # the run is taken as the fob's true position, wherever it is
                accepted_counter = counter
                last_result = RESULT_RESYNCED
                run = []
            else:
                last_result = RESULT_STALE_COUNTER
            continue

        behind_high_water = 0 < (high_water - counter) & COUNTER_MASK <= WINDOW
        accepted_counter = counter
        if not behind_high_water:
            high_water = counter
        deaf_until = time.time() + DEBOUNCE_SECONDS
        unlocks += 1
        last_result = RESULT_UNLOCKED

    if behind_high_water:
        bus.send_text(FLAG_ID, flag)
